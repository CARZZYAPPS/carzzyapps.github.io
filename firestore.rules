rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isCremaRushAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid))
        && get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.enabled == true;
    }

    match /adminUsers/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    match /usernames/{username} {
      function validUsernameClaim(data) {
        return data.keys().hasAll(['uid', 'guest', 'username'])
          && data.keys().hasOnly(['uid', 'guest', 'username'])
          && data.uid == request.auth.uid
          && data.guest is bool
          && data.username is string
          && data.username.matches('^[A-Za-z0-9_]{3,20}$')
          && username.matches('^[a-z0-9_]{3,20}$')
          && (data.guest
            ? request.auth.token.firebase.sign_in_provider == 'anonymous'
            : request.auth.token.email is string);
      }

      allow read: if true;
      allow create: if request.auth != null
        && validUsernameClaim(request.resource.data);
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && validUsernameClaim(request.resource.data);
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    match /usernameAuthLookup/{username} {
      allow read, write: if false;
    }

    match /guestAccounts/{playerId} {
      allow read, write: if false;
    }

    match /cremaTycoonSaves/{playerId} {
      function isNumber(value) {
        return value is int || value is float;
      }

      function validGameState(state) {
        return state.keys().hasAll([
          'v', 'day', 'cash', 'rating', 'lvl', 'mach', 'spd',
          'cashiers', 'baristas', 'cTrain', 'bTrain', 'locs', 'served', 'earned'
        ])
        && state.keys().hasOnly([
          'v', 'day', 'cash', 'rating', 'lvl', 'mach', 'spd',
          'cashiers', 'baristas', 'cTrain', 'bTrain', 'locs', 'served', 'earned'
        ])
        && state.v == 1
        && isNumber(state.day)
        && state.day >= 1
        && isNumber(state.cash)
        && isNumber(state.rating)
        && state.rating >= 1
        && state.rating <= 5
        && state.lvl is int
        && state.lvl >= 1
        && state.lvl <= 3
        && state.mach is list
        && state.mach.size() >= 1
        && state.mach.size() <= 11
        && state.mach.hasOnly(['E', 'M', 'D', 'C'])
        && state.spd is map
        && state.spd.keys().hasAll(['E', 'M', 'D', 'C'])
        && state.spd.keys().hasOnly(['E', 'M', 'D', 'C'])
        && state.spd.E is int
        && state.spd.E >= 0
        && state.spd.E <= 3
        && state.spd.M is int
        && state.spd.M >= 0
        && state.spd.M <= 3
        && state.spd.D is int
        && state.spd.D >= 0
        && state.spd.D <= 3
        && state.spd.C is int
        && state.spd.C >= 0
        && state.spd.C <= 3
        && state.cashiers is int
        && state.cashiers >= 0
        && state.cashiers <= 3
        && state.baristas is int
        && state.baristas >= 0
        && state.baristas <= 4
        && state.cTrain is int
        && state.cTrain >= 0
        && state.cTrain <= 3
        && state.bTrain is int
        && state.bTrain >= 0
        && state.bTrain <= 3
        && state.locs is map
        && state.locs.keys().hasOnly(['kiosk', 'midtown', 'airport', 'roastery'])
        && (!('kiosk' in state.locs) || (state.locs.kiosk is int && state.locs.kiosk >= 0 && state.locs.kiosk <= 3))
        && (!('midtown' in state.locs) || (state.locs.midtown is int && state.locs.midtown >= 0 && state.locs.midtown <= 3))
        && (!('airport' in state.locs) || (state.locs.airport is int && state.locs.airport >= 0 && state.locs.airport <= 3))
        && (!('roastery' in state.locs) || (state.locs.roastery is int && state.locs.roastery >= 0 && state.locs.roastery <= 3))
        && isNumber(state.served)
        && state.served >= 0
        && isNumber(state.earned)
        && state.earned >= 0;
      }

      function validGameSave(data) {
        return data.keys().hasAll(['state', 'updatedAt'])
          && data.keys().hasOnly(['state', 'updatedAt'])
          && data.state is map
          && validGameState(data.state)
          && data.updatedAt == request.time;
      }

      allow read: if request.auth != null && request.auth.uid == playerId;
      allow create, update: if request.auth != null
        && request.auth.uid == playerId
        && validGameSave(request.resource.data);
      allow delete: if false;
    }

    match /cremaRushProgress/{playerId} {
      function validRushProgress(data) {
        return data.keys().hasAll([
            'best', 'lastScore', 'lastServed', 'shifts', 'updatedAt'
          ])
          && data.keys().hasOnly([
            'best', 'lastScore', 'lastServed', 'shifts', 'adminRevision', 'username', 'updatedAt'
          ])
          && data.best is int
          && data.best >= 0
          && data.lastScore is int
          && data.lastScore >= 0
          && data.lastServed is int
          && data.lastServed >= 0
          && data.shifts is int
          && data.shifts >= 0
          && (!('adminRevision' in data)
            || (data.adminRevision is int && data.adminRevision >= 0))
          && (!('username' in data)
            || (data.username is string && data.username.matches('^[A-Za-z0-9_]{3,20}$')))
          && data.updatedAt == request.time;
      }

      allow read: if (request.auth != null && request.auth.uid == playerId)
        || isCremaRushAdmin();
      allow create: if request.auth != null
        && request.auth.uid == playerId
        && validRushProgress(request.resource.data)
        && (!('adminRevision' in request.resource.data) || request.resource.data.adminRevision == 0);
      allow update: if (request.auth != null
          && request.auth.uid == playerId
          && validRushProgress(request.resource.data)
          && (('adminRevision' in resource.data
              && 'adminRevision' in request.resource.data
              && request.resource.data.adminRevision == resource.data.adminRevision)
            || (!('adminRevision' in resource.data)
              && (!('adminRevision' in request.resource.data)
                || request.resource.data.adminRevision == 0))))
        || (isCremaRushAdmin()
          && validRushProgress(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'best', 'adminRevision', 'username', 'updatedAt'
          ])
          && request.resource.data.adminRevision
            == (('adminRevision' in resource.data) ? resource.data.adminRevision : 0) + 1);
      allow delete: if false;
    }

    match /cremaRushScoreEvents/{eventId} {
      function validPlayerScoreEvent(data) {
        return data.keys().hasAll([
            'actorType', 'uid', 'username', 'best', 'lastScore',
            'lastServed', 'shifts', 'savedAt'
          ])
          && data.keys().hasOnly([
            'actorType', 'uid', 'username', 'best', 'lastScore',
            'lastServed', 'shifts', 'savedAt'
          ])
          && data.actorType == 'player'
          && data.uid == request.auth.uid
          && data.username is string
          && data.username.matches('^[A-Za-z0-9_]{3,20}$')
          && data.best is int
          && data.best >= 0
          && data.lastScore is int
          && data.lastScore >= 0
          && data.lastServed is int
          && data.lastServed >= 0
          && data.shifts is int
          && data.shifts >= 0
          && data.savedAt == request.time;
      }

      function validAdminScoreEvent(data) {
        return data.keys().hasAll([
            'actorType', 'uid', 'username', 'previousBest',
            'newBest', 'changedBy', 'savedAt'
          ])
          && data.keys().hasOnly([
            'actorType', 'uid', 'username', 'previousBest',
            'newBest', 'changedBy', 'savedAt'
          ])
          && data.actorType == 'admin'
          && data.uid is string
          && data.username is string
          && data.username.matches('^[A-Za-z0-9_]{3,20}$')
          && data.previousBest is int
          && data.previousBest >= 0
          && data.newBest is int
          && data.newBest >= 0
          && data.changedBy == request.auth.token.email
          && data.savedAt == request.time;
      }

      allow read: if isCremaRushAdmin();
      allow create: if request.auth != null
        && (validPlayerScoreEvent(request.resource.data)
          || (isCremaRushAdmin() && validAdminScoreEvent(request.resource.data)));
      allow update, delete: if false;
    }

  }
}
